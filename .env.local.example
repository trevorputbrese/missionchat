# Shared password for the app's unlock gate. Unset means nobody can unlock.
MISSIONCHAT_SHARED_PASSWORD=replace-with-a-strong-password

SPRING_AI_OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
SPRING_AI_OPENAI_API_KEY=replace-with-your-local-key
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_CHAT_OPTIONS_TEMPERATURE=0.2
# Optional override if your provider needs a different path.
# Example for root base URLs: /v1/chat/completions
SPRING_AI_OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
